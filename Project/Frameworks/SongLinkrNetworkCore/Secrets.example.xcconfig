//
//  Secrets.example.xcconfig
//  SongLinkrNetworkCore
//
//  Copy this file to `Secrets.xcconfig` (git-ignored) in the same directory and fill in
//  the real shared secret used to authenticate against the SongLinkr proxy. This example
//  file is committed to git and must never contain a real token.
//
//  Note: xcconfig syntax treats "//" as a comment and "$(...)" as a variable substitution,
//  so the token value itself must not contain either of those sequences.
//

SONGLINK_AUTH_TOKEN = REPLACE_WITH_YOUR_LOCAL_TOKEN
